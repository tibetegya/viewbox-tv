{
  "name": "viewbox-tv-tizenbrew",
  "version": "0.7.0",
  "private": true,
  "description": "Jellyfin-style TV UI (TV layout) for a streaming site: home rows, libraries, search, details, player OSD, next-episode countdown, 'Are you still watching?'. Pick the site address on the TV.",
  "packageType": "mods",
  "appName": "Viewbox TV",
  "websiteURL": "https://tibetegya.dev/viewbox-tv/",
  "main": "dist/main.js",
  "evaluateScriptOnDocumentStart": false,
  "keys": [
    "MediaPlayPause",
    "MediaPlay",
    "MediaPause",
    "MediaFastForward",
    "MediaRewind",
    "ColorF0Red"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs",
    "wgt": "npm run build && node wgt/build.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "adbhost": "^0.0.2",
    "chrome-remote-interface": "^0.25.7",
    "esbuild": "^0.25.0"
  },
  "viewboxService": 1
}
